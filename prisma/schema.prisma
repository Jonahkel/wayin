// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())
  username        String   @unique
  profileImageUrl String?
  isPrivate       Boolean  @default(false)
  reviews         Review[]
}

model Location {
  id           Int      @id
  reviewCount  Int
  name         String
  address      String
  city         String
  state        String
  zip          String
  latitude     Float
  longitude    Float
  reviews      Review[]
}

model Tag {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  isActive    Boolean           @default(true)
  reviewTags  ReviewTagRating[]
}


model Review {
  id          Int      @id @default(autoincrement())
  title       String?
  // we can add a check to make sure either comment or review is present in the future
  // right now they're both optional (a review with neither could be stored)
  // i didn't want to mess with the fields too much yet
  rating      Int?
  comment     String?
  userId      Int
  user       User     @relation(fields: [userId], references: [id])
  locationId  Int
  location    Location @relation(fields: [locationId], references: [id])
  createdAt  DateTime @default(now())
  tagRatings  ReviewTagRating[]


  // not sure if we want to limit one review per location per user, if so use this:
  // @@unique([userId, locationId])
  // if we do this, we likely would need to allow edits to existing reviews
}

model ReviewTagRating {
  id         Int      @id @default(autoincrement())
  reviewId   Int
  tagId      Int
  rating     Int      // enforce 1-3 in app validation (or DB check constraint)
  createdAt  DateTime @default(now())

  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id])

  @@unique([reviewId, tagId]) // one rating per tag per review
  @@index([tagId, rating])    // useful for filtering
}